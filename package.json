{
  "name": "zero-ai-ui-lib",
  "version": "0.1.1",
  "description": "Vue 3 组件库：形变菜单、自绘下拉、日期/时间选择器、可展开卡片、底部面板与对话框",
  "author": "Jaly",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/zero-ai-ui-lib.cjs",
  "module": "./dist/zero-ai-ui-lib.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zero-ai-ui-lib.mjs",
      "require": "./dist/zero-ai-ui-lib.cjs"
    },
    "./style.css": "./dist/zero-ai-ui-lib.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist-app",
    "preview": "vite preview --outDir dist-app",
    "build:lib": "vite build --config vite.lib.config.js && node scripts/copy-types.mjs",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  }
}
